{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research project page configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string"
        },
        "favicon": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    },
    "social_preview": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "twitter_card": {
          "enum": [
            "summary",
            "summary_large_image"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "affiliations": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "affiliations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "venue": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "template_name": {
          "type": "string"
        },
        "template_url": {
          "type": "string"
        },
        "license_name": {
          "type": "string"
        },
        "license_url": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "site",
    "sections"
  ],
  "additionalProperties": false,
  "$defs": {
    "media": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "image",
            "video"
          ]
        },
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "poster": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "controls": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "teaser",
            "content",
            "media",
            "embed",
            "interactive",
            "bibtex"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "media": {
          "$ref": "#/$defs/media"
        },
        "caption": {
          "type": "string"
        },
        "align": {
          "enum": [
            "left",
            "justified"
          ]
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/media"
          }
        },
        "src": {
          "type": "string"
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "entry": {
          "type": "string"
        },
        "export": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object"
        },
        "citation": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
